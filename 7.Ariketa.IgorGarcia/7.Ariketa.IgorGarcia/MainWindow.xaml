<Window x:Class="_7.Ariketa.IgorGarcia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kalkulagailua" Height="330" Width="270"
        KeyDown="Window_KeyDown">

    <Grid>
        <TextBlock x:Name="txtPantaila" Text="0," Margin="10,10,0,0" Width="230" Height="50"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Background="Yellow" FontSize="28" FontWeight="Bold" TextAlignment="Right"/>

        <Button Content="7" Margin="10,70,0,0" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Click="ZenbBtn_Click"/>
        <Button Content="8" Margin="55,70,0,0" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Click="ZenbBtn_Click"/>
        <Button Content="9" Margin="100,70,0,0" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Click="ZenbBtn_Click"/>
        <Button Content="C" Margin="145,70,0,0" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Click="C_Click"/>
        <Button Content="CE" Margin="190,70,0,0" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Click="CE_Click"/>

        <Button Content="4" Margin="10,115,0,0" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Click="ZenbBtn_Click"/>
        <Button Content="5" Margin="55,115,0,0" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Click="ZenbBtn_Click"/>
        <Button Content="6" Margin="100,115,0,0" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Click="ZenbBtn_Click"/>
        <Button Content="/" Margin="145,115,0,0" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Click="EragiketaBtn_Click"/>
        <Button Content="-" Margin="190,115,0,0" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Click="EragiketaBtn_Click"/>

        <Button Content="1" Margin="10,160,0,0" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Click="ZenbBtn_Click"/>
        <Button Content="2" Margin="55,160,0,0" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Click="ZenbBtn_Click"/>
        <Button Content="3" Margin="100,160,0,0" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Click="ZenbBtn_Click"/>
        <Button Content="×" Margin="145,160,0,0" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Click="EragiketaBtn_Click"/>
        <Button Content="+" Margin="190,160,0,0" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Click="EragiketaBtn_Click"/>

        <Button Content="0" Margin="10,205,0,0" Width="85" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Click="ZenbBtn_Click"/>
        <Button Content="," Margin="100,205,0,0" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Click="KomaBtn_Click"/>
        <Button Content="=" Margin="145,205,0,0" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Click="BerdinBtn_Click"/>
        <Button Content="%" Margin="190,205,0,0" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Click="EhunekoBtn_Click"/>
    </Grid>
</Window>