<Window x:Class="_8.Ariketa.IgorGarcia.DatenAldea"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Daten aldea" Height="180" Width="300">
    <Grid>
        <Label x:Name="Mezualbl" Content="Sartu data honela: &#xD;&#xA;dd/mm/uuuu"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"/>

        <TextBox x:Name="DataTextBox" Text="01/01/2011"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,70,0,0" Width="180" Height="23"
                 TextChanged="DataTextBox_TextChanged"/>

        <Button Content="Onartu"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Width="70" Height="25"
                Click="Onartu_Click"/>

        <Button Content="Utzi"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,45,10,0" Width="70" Height="25"
                Click="Utzi_Click"/>
    </Grid>
</Window>