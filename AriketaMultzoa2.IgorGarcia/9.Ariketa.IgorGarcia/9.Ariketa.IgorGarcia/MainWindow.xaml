<Window x:Class="_9.Ariketa.IgorGarcia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_9.Ariketa.IgorGarcia"
        mc:Ignorable="d"
        Title="Lagun-Zerrenda" Height="450" Width="800">
    <Grid>
        <ListBox x:Name="LagunakList" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="20,45,0,0" Width="180" Height="180"
                 SelectionMode="Extended"
                 MouseDoubleClick="ListaIzenaAukeratu"/>
        <Label Content="Nire Lagunak" HorizontalAlignment="Left" Margin="20,10,0,0" VerticalAlignment="Top"/>
        
        <Button Content="Gehitu" HorizontalAlignment="Left" Margin="270,45,0,0" VerticalAlignment="Top" Width="110" Height="31" FontSize="16" Click="Gehitu_Click"/>
        <Button Content="Ezabatu" HorizontalAlignment="Left" Margin="270,105,0,0" VerticalAlignment="Top" Width="110" Height="31" FontSize="16" Click="Ezabatu_Click"/>
        <Button x:Name="btnGarbitu" Content="Zerrenda Garbitu" HorizontalAlignment="Left" Margin="270,165,0,0" VerticalAlignment="Top" Width="130" Height="31" FontSize="16" Click="Garbitu_Click"/>
        
        <TextBox x:Name="txtHautatuta" HorizontalAlignment="Left" Margin="20,303,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="180" Height="30"/>
        <Label Content="Hautatutako Laguna" HorizontalAlignment="Left" Margin="20,259,0,0" VerticalAlignment="Top"/>
        
        <TextBox x:Name="txtGehitu" HorizontalAlignment="Left" Margin="20,360,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="180" Height="30"/>
        <Label Content="Lagun Berria" HorizontalAlignment="Left" Margin="20,340,0,0" VerticalAlignment="Top"/>
    </Grid>
</Window>
