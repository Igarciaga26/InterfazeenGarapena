<Window x:Class="_4.Ariketa.IgorGarcia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_4.Ariketa.IgorGarcia"
        mc:Ignorable="d"
        Title="Erabiltzailearen identifikazioa" Height="350" Width="450" Background="LightGray">
    <Grid>
        <Label Content="Erabiltzailea:" HorizontalAlignment="Left" Margin="55,90,0,0" VerticalAlignment="Top" FontSize="14"/>
        <TextBox Name="txtErabiltzailea" HorizontalAlignment="Left" Margin="142,90,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Height="30"/>
        <Label Content="Pasahitza:" HorizontalAlignment="Left" Margin="55,150,0,0" VerticalAlignment="Top" FontSize="14"/>
        <PasswordBox Name="txtPassword" HorizontalAlignment="Left" Margin="142,150,0,0"  VerticalAlignment="Top" Width="120" Height="30" PasswordChar="*"/>
        <Button Name="onartuBtn" Content="Onartu" HorizontalAlignment="Left" Margin="32,210,0,0" VerticalAlignment="Top" Width="80" Height="30" Background="White" FontSize="13" BorderBrush="Black" Click="Onartu_Click"/>
        <Button Name="garbituBtn" Content="Garbitu" HorizontalAlignment="Left" Margin="130,210,0,0" VerticalAlignment="Top" Width="80" Height="30" Background="White" FontSize="13" BorderBrush="Black" Click="Garbitu_Click"/>
        <Button Name="irtenBtn" Content="Irten" HorizontalAlignment="Left" Margin="230,210,0,0" VerticalAlignment="Top" Width="80" Height="30" Background="White" FontSize="13" BorderBrush="Black" Click="Irten_Click"/>
        <Label Name="lblEmaitza" Content="" HorizontalAlignment="Left" Margin="120,255,0,0" VerticalAlignment="Top"/>



    </Grid>
</Window>
