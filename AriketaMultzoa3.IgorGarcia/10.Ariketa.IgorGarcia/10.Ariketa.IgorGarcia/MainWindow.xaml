<Window x:Class="_10.Ariketa.IgorGarcia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_10.Ariketa.IgorGarcia"
        mc:Ignorable="d"
        Title="IrudiakBistaratu" Height="450" Width="800" Background="LightGray">
    <Grid>
        <Label Content="NIRE IRUDIAK" HorizontalAlignment="Center" Margin="0,46,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="24"/>
        <Label Content="1.Ilara" HorizontalAlignment="Left" Height="25" Margin="35,137,0,0" VerticalAlignment="Top" Width="65"/>
        <ComboBox x:Name="comboIrudi" HorizontalAlignment="Left" Margin="35,162,0,0" VerticalAlignment="Top" Width="120" Background="White" BorderBrush="White"
                  SelectionChanged="comboIrudi_Aukera"/>
        <Label Content="2.Ilara" HorizontalAlignment="Left" Margin="35,301,0,0" VerticalAlignment="Top"/>
        <CheckBox x:Name="chkIrudia4" Content="Irudia 4" HorizontalAlignment="Left" Margin="35,332,0,0" VerticalAlignment="Top"
                  Checked="checkBox_Aukera" Unchecked="checkBox_Aukera"/>
        <CheckBox x:Name="chkIrudia5" Content="Irudia 5" HorizontalAlignment="Left" Margin="35,352,0,0" VerticalAlignment="Top"
                  Checked="checkBox_Aukera" Unchecked="checkBox_Aukera"/>
        <CheckBox x:Name="chkIrudia6" Content="Irudia 6" HorizontalAlignment="Left" Margin="35,372,0,0" VerticalAlignment="Top"
                  Checked="checkBox_Aukera" Unchecked="checkBox_Aukera"/>

        <Image x:Name="imgCombo" Stretch="Fill" Width="180" Height="140"
               HorizontalAlignment="Left" Margin="450,120,0,0" VerticalAlignment="Top"/>

        <Image x:Name="imgIrudia4" Stretch="Fill" Width="130" Height="110"
               HorizontalAlignment="Left" Margin="220,290,0,0" VerticalAlignment="Top" Visibility="Collapsed"/>
        <Image x:Name="imgIrudia5" Stretch="Fill" Width="130" Height="110"
               HorizontalAlignment="Left" Margin="360,290,0,0" VerticalAlignment="Top" Visibility="Collapsed"/>
        <Image x:Name="imgIrudia6" Stretch="Fill" Width="130" Height="110"
               HorizontalAlignment="Left" Margin="500,290,0,0" VerticalAlignment="Top" Visibility="Collapsed"/>

        <Button Content="Irten" Width="80" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,35,30" Click="Irten_Click"/>

    </Grid>
</Window>