<Window x:Class="Erronka.IgorGarcia.Erreserbak"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Erronka.IgorGarcia"
        mc:Ignorable="d"
        Title="Erreserbak"
        Height="720"
        Width="1280"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Language="es-ES"
        Background="#F5F6FA"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Goiburuko nabigazio fitxa -->
        <Style x:Key="NavTab" TargetType="Button">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fitxa aktiboa (uneko leihoa) -->
        <Style x:Key="NavTabActive" TargetType="Button" BasedOn="{StaticResource NavTab}">
            <Setter Property="Foreground" Value="#1E5EFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                                BorderBrush="#1E5EFF"
                                BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ekintza botoi biribildua -->
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mahai botoia -->
        <Style x:Key="TableButton" TargetType="Button">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.TextAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Txartel zuria, ertz leunarekin eta itzal arinarekin -->
        <Style x:Key="Box" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="12" ShadowDepth="2" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Txartelaren izenburua -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Eremuaren etiketa -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <!-- TextBox biribildua -->
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1E5EFF"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= GOIKO MENUA ================= -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">
            <Grid Margin="25,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Logotipoa / izenburua -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Background="#1E5EFF">
                        <TextBlock Text="T" Foreground="White" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="TPV Elkartea"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="#111827"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Nabigazioa -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="40,0,0,0">
                    <Button Content="Menua"          Style="{StaticResource NavTab}" Click="Menua_Click"/>
                    <Button Content="Erreserbak"     Style="{StaticResource NavTabActive}"/>
                    <Button x:Name="btnBiltegia" Content="Biltegia" Style="{StaticResource NavTab}" Visibility="Collapsed" Click="Biltegia_Click"/>
                    <Button x:Name="btnErabiltzaileak" Content="Erabiltzaileak" Style="{StaticResource NavTab}" Visibility="Collapsed" Click="Erabiltzaileak_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= EDUKI NAGUSIA ================= -->
        <Grid Grid.Row="1" Margin="25,20,25,25">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- DATA ETA TXANDA -->
            <Border Grid.Row="0"
                    Style="{StaticResource Box}"
                    Padding="18,14"
                    Margin="0,0,0,16">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Erreserbaren data"
                               Style="{StaticResource CardTitle}"
                               FontSize="14"
                               Margin="0,0,12,0"/>

                    <DatePicker x:Name="dpData"
                                Grid.Column="1"
                                Height="34"
                                FontSize="14"
                                VerticalContentAlignment="Center"
                                VerticalAlignment="Center"
                                SelectedDateChanged="DpData_SelectedDateChanged"/>

                    <TextBlock Grid.Column="2"
                               Text="Txanda"
                               Style="{StaticResource CardTitle}"
                               FontSize="14"
                               HorizontalAlignment="Right"
                               Margin="10,0,12,0"/>

                    <Button x:Name="btnBazkaria"
                            Grid.Column="3"
                            Content="Bazkaria"
                            Width="120"
                            Height="38"
                            Margin="4,0"
                            Style="{StaticResource RoundButton}"
                            Click="Bazkaria_Click"/>

                    <Button x:Name="btnAfaria"
                            Grid.Column="4"
                            Content="Afaria"
                            Width="120"
                            Height="38"
                            Margin="4,0,0,0"
                            Style="{StaticResource RoundButton}"
                            Click="Afaria_Click"/>
                </Grid>
            </Border>

            <!-- MAHAIEN PLANOA ETA ERRESERBA DATUAK -->
            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- MAHAIEN PLANOA -->
                <Border Grid.Column="0"
                        Style="{StaticResource Box}"
                        Padding="20"
                        Margin="0,0,10,0">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="45"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Mahaien planoa"
                                   Style="{StaticResource CardTitle}"/>

                        <!-- MAHAIAK (kodetik sortzen dira) -->
                        <UniformGrid x:Name="ugMahaiak" Grid.Row="1" Columns="3"/>

                        <!-- KOLOREEN LEGENDA -->
                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <Border Width="14" Height="14" CornerRadius="4" Background="#E8F5E9"
                                    BorderBrush="#A5D6A7" BorderThickness="1" Margin="5"/>
                            <TextBlock Text="Libre" Foreground="#6B7280" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,18,0"/>

                            <Border Width="14" Height="14" CornerRadius="4" Background="#FDECEA"
                                    BorderBrush="#F1A9A0" BorderThickness="1" Margin="5"/>
                            <TextBlock Text="Erreserbatuta" Foreground="#6B7280" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,18,0"/>

                            <Border Width="14" Height="14" CornerRadius="4" Background="#DBEAFE"
                                    BorderBrush="#1E5EFF" BorderThickness="1" Margin="5"/>
                            <TextBlock Text="Hautatuta" Foreground="#6B7280" FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                    </Grid>
                </Border>

                <!-- ERRESERBAREN DATUAK -->
                <Border Grid.Column="1"
                        Style="{StaticResource Box}"
                        Padding="20,20,12,20"
                        Margin="10,0,0,0">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Erreserbaren datuak"
                                   Style="{StaticResource CardTitle}"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,8,0">

                                <TextBlock Text="Hautatutako mahaia" Style="{StaticResource FieldLabel}" Margin="0,4,0,4"/>
                                <TextBox x:Name="txtMahaia" Height="34" IsReadOnly="True"/>

                                <TextBlock Text="Bezeroaren izena" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtIzena" Height="34"/>

                                <TextBlock Text="Telefonoa" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtTelefonoa" Height="34"/>

                                <TextBlock Text="Pertsona kopurua" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbPertsonak" Height="34" FontSize="14"
                                          VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="4"/>
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="6"/>
                                    <ComboBoxItem Content="7"/>
                                    <ComboBoxItem Content="8"/>
                                </ComboBox>

                                <TextBlock Text="Ordua" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbOrdua" Height="34" FontSize="14"
                                          VerticalContentAlignment="Center"/>

                                <TextBlock Text="Oharrak" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtOharrak"
                                         Height="60"
                                         Padding="8,6"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalContentAlignment="Top"/>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

            </Grid>

            <!-- BEHEKO BOTOIAK -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">

                <Button Content="Garbitu" Width="110" Height="40" Margin="5,0"
                        Style="{StaticResource RoundButton}"
                        Click="Garbitu_Click"/>

                <Button Content="Ezabatu" Width="110" Height="40" Margin="5,0"
                        Style="{StaticResource RoundButton}"
                        Background="#FDECEA"
                        Foreground="#B42318"
                        Click="Ezabatu_Click"/>

                <Button Content="Aldatu" Width="110" Height="40" Margin="5,0"
                        Style="{StaticResource RoundButton}"
                        Click="Aldatu_Click"/>

                <Button Content="Erreserba gorde" Width="150" Height="40" Margin="5,0,0,0"
                        Style="{StaticResource RoundButton}"
                        Background="#1E5EFF"
                        Foreground="White"
                        Click="Gorde_Click"/>
            </StackPanel>

        </Grid>
    </Grid>
</Window>