<Window x:Class="_3.Ariketa.IgorGarcia.EmaitzaLeihoa"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emaitza" Height="250" Width="350" Background="LightGray">
    <Grid>
        <Label Content="Emaitza:" HorizontalAlignment="Left" Margin="40,50,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="Txtresultado" HorizontalAlignment="Left" Margin="110,50,0,0" VerticalAlignment="Top" Width="180" Height="25" IsReadOnly="True" Background="White"/>

        <Button Content="Garbitu" HorizontalAlignment="Left" Margin="40,130,0,0" VerticalAlignment="Top" Width="110" Height="30" Background="White" Click="Garbitu_Click"/>
        <Button Content="Irten" HorizontalAlignment="Left" Margin="180,130,0,0" VerticalAlignment="Top" Width="110" Height="30" Background="White" Click="Irten_Click"/>
    </Grid>
</Window>